    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-8080}"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.0",
    "firebase": "^12.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "firebase-admin": "14.3.0",
    "typescript": "5.8.2"
  }
}
