{
  "name": "pie-diabetico-gestion-clinica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix functions test",
    "test:emulators": "firebase emulators:exec --project demo-pie-diabetico --only auth,functions,firestore,storage \"node functions/emulator-smoke.js\"",
    "seed:review": "node scripts/seed-local-review.cjs",
    "validate": "npm run typecheck && npm test && npm run build && npm --prefix functions run lint",
    "start": "npx vite preview --host 0.0.0.0 --port ${PORT:-8080}",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-8080}",
    "verify:prod": "node scripts/verify_staging_readiness.cjs",
    "verify:prod:strict": "node scripts/verify_staging_readiness.cjs --strict",
    "check:canary:health": "node scripts/check-canary-health.cjs",
    "verify:canary": "npm run verify:prod && npm run verify:prod:strict"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.0",
    "firebase": "^12.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "firebase-admin": "14.3.0",
    "firebase-tools": "^15.6.0",
    "typescript": "5.8.2"
  }
}
